[Unit]
Description=mauricefun.lol Untappd scraper trigger API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/VPS_Coding_full
EnvironmentFile=-/home/ubuntu/VPS_Coding_full/.env
ExecStart=/home/ubuntu/VPS_Coding_full/.venv/bin/python -m mauricefun.untappd.scraper_api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
