# =============================================================================
# mauricefun.lol – environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- FoxESS solar API (scripts/fetch_solar.py) ---
FOXESS_API_KEY=
FOXESS_DEVICE_SN=

# --- OpenRouter LLM API (remontees scraper summaries) ---
OPENROUTER_API_KEY=

# --- Telegram balloon notifier (ballon_notifier/ballon_bot.py) ---
TELEGRAM_BOT_TOKEN=

# --- Filesystem paths ---
# Webroot served by nginx (defaults to the production path).
WEB_ROOT=/var/www/mauricefun.lol/html
# Directory holding scraped/generated JSON data.
DATA_DIR=/var/www/mauricefun.lol/html/data
# Directory holding the results site.
RESULTS_DIR=/home/ubuntu/VPS_Coding_full/results

# --- Monitoring server (server.py) ---
STATS_HOST=0.0.0.0
STATS_PORT=8080
STREAMLIT_URL=http://127.0.0.1:8501

# --- Remontees API ---
REMONTEES_SCRAPER_PATH=/home/ubuntu/projects/mauricefun.lol/scripts/scrape_remontees.py
REMONTEES_DATA_FILE=/home/ubuntu/projects/mauricefun.lol/html/data/remontees_data.json

# --- Untappd scraper API ---
UNTAPPD_SCRAPER_PATH=/home/ubuntu/projects/VPS_Coding/untappd/scripts/auto_scraper.py
UNTAPPD_STATS_FILE=/home/ubuntu/projects/mauricefun.lol/html/untappd/data/stats.json

# --- Balloon notifier ---
BALLOON_FLIGHT_LOG_FILE=/home/ubuntu/VPS_Coding_full/ballons/balloon_flights.json
BALLOON_DATA_DIR=/home/ubuntu/VPS_Coding_full/ballon_notifier

# --- Monitoring history ---
# Number of 5-second samples retained for the history API (default: 17280 = 24h)
HISTORY_MAXLEN=17280
