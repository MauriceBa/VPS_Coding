{
  "name": "mauricefun-web",
  "version": "1.0.0",
  "private": true,
  "description": "Static sites, browser games and tools for mauricefun.lol",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "lint": "eslint \"**/*.{js,mjs,cjs}\"",
    "lint:fix": "eslint \"**/*.{js,mjs,cjs}\" --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,json,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "jsdom": "^24.1.1",
    "prettier": "^3.3.3",
    "vitest": "^2.0.5"
  }
}
